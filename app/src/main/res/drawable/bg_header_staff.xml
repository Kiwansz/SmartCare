<?xml version="1.0" encoding="utf-8"?>
<!-- Header "mesh" gradient approximated with stacked radial gradients, plus two thin
     translucent circles at the top right (design: .hero). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/navy_main" /></shape></item>
    <item><shape><gradient android:type="radial" android:centerX="0" android:centerY="0"
        android:gradientRadius="320dp" android:startColor="@color/navy_header_glow" android:endColor="#001A4F9E" /></shape></item>
    <item><shape><gradient android:type="radial" android:centerX="1" android:centerY="0"
        android:gradientRadius="250dp" android:startColor="@color/navy_accent" android:endColor="#003A86DC" /></shape></item>
    <item><shape><gradient android:type="radial" android:centerX="0.7" android:centerY="1.15"
        android:gradientRadius="340dp" android:startColor="@color/navy_header_dark" android:endColor="#00061A3D" /></shape></item>
    <item android:width="340dp" android:height="340dp" android:gravity="top|end"
        android:top="-120dp" android:right="-160dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="@color/hero_circle" /></shape>
    </item>
    <item android:width="230dp" android:height="230dp" android:gravity="top|end"
        android:top="-55dp" android:right="-95dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="@color/hero_circle" /></shape>
    </item>
</layer-list>
