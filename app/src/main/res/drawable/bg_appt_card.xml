<?xml version="1.0" encoding="utf-8"?>
<!-- Same layered gradient as the patient header, 28dp corners, one thin circle bottom-right. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item><shape><solid android:color="@color/sky_main" /><corners android:radius="28dp" /></shape></item>
    <item><shape><gradient android:type="radial" android:centerX="0" android:centerY="0" android:gradientRadius="260dp" android:startColor="#FF36B4EA" android:endColor="#0036B4EA" /><corners android:radius="28dp" /></shape></item>
    <item><shape><gradient android:type="radial" android:centerX="1" android:centerY="0" android:gradientRadius="200dp" android:startColor="#FFA6E3FF" android:endColor="#00A6E3FF" /><corners android:radius="28dp" /></shape></item>
    <item android:width="240dp" android:height="240dp" android:gravity="bottom|end" android:bottom="-120dp" android:right="-95dp">
        <shape android:shape="oval"><stroke android:width="1dp" android:color="#38FFFFFF" /></shape>
    </item>
</layer-list>
