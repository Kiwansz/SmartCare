<?xml version="1.0" encoding="utf-8"?>
<!-- Pill button: vertical gradient from scBtnTop to scMain (theme-dependent). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android" android:color="#33FFFFFF">
    <item>
        <shape>
            <corners android:radius="999dp" />
            <gradient android:angle="270" android:startColor="?attr/scBtnTop" android:endColor="?attr/scMain" />
        </shape>
    </item>
</ripple>
