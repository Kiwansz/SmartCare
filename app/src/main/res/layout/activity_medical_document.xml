<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">
            <include layout="@layout/view_auth_header" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="-28dp"
                android:background="@drawable/bg_sheet"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="9dp"
                android:paddingBottom="24dp">
                        <View
                            android:layout_width="36dp"
                            android:layout_height="4dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginBottom="16dp"
                            android:background="@drawable/bg_grab_handle" />

                        <ProgressBar
                            android:id="@+id/progress"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center_horizontal" />

                        <LinearLayout
                            android:id="@+id/documentError"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            style="@style/SmartCare.Text.Sub"
                                            android:text="@string/medical_error" />

                                        <com.google.android.material.button.MaterialButton
                                            android:id="@+id/documentRetry"
                                            style="@style/SmartCare.Button.Pill"
                                            android:layout_width="match_parent"
                                            android:layout_marginTop="12dp"
                                            android:text="@string/medical_retry" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/documentAppointmentMessage"
                            style="@style/SmartCare.Text.Sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/documentEditor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">
                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            style="@style/SmartCare.Text.Sub"
                                            android:text="@string/document_editor_notice" />

                                        <LinearLayout
                                            android:id="@+id/documentPrescriptionForm"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="vertical"
                                            android:visibility="gone">
                                                            <LinearLayout
                                                                android:id="@+id/documentMedicationItems"
                                                                android:layout_width="match_parent"
                                                                android:layout_height="wrap_content"
                                                                android:orientation="vertical">

                                                            </LinearLayout>

                                                            <com.google.android.material.button.MaterialButton
                                                                android:id="@+id/documentAddMedication"
                                                                style="@style/Widget.Material3.Button.OutlinedButton"
                                                                android:layout_width="match_parent"
                                                                android:layout_height="wrap_content"
                                                                android:layout_marginTop="12dp"
                                                                android:text="@string/document_add_medication" />
                                        </LinearLayout>

                                        <LinearLayout
                                            android:id="@+id/documentCertificateForm"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:orientation="vertical"
                                            android:visibility="gone">
                                                            <com.example.smartcare.ui.SmartField
                                                                android:id="@+id/documentPatientName"
                                                                android:layout_width="match_parent"
                                                                android:layout_height="wrap_content"
                                                                android:layout_marginTop="8dp"
                                                                android:inputType="textPersonName"
                                                                android:maxLength="80"
                                                                android:importantForAutofill="noExcludeDescendants"
                                                                app:sfLabel="@string/document_patient_name" />

                                                            <com.example.smartcare.ui.SmartField
                                                                android:id="@+id/documentDoctorName"
                                                                android:maxLength="80"
                                                                android:layout_width="match_parent"
                                                                android:layout_height="wrap_content"
                                                                android:layout_marginTop="8dp"
                                                                android:inputType="textCapSentences"
                                                                android:importantForAutofill="noExcludeDescendants"
                                                                app:sfLabel="@string/document_doctor_name" />

                                                            <com.example.smartcare.ui.SmartField
                                                                android:id="@+id/documentIssueDate"
                                                                android:layout_width="match_parent"
                                                                android:layout_height="wrap_content"
                                                                android:layout_marginTop="8dp"
                                                                android:inputType="textNoSuggestions"
                                                                android:importantForAutofill="noExcludeDescendants"
                                                                android:maxLength="10"
                                                                app:sfHelper="@string/document_date_format"
                                                                app:sfLabel="@string/document_issue_date" />

                                                            <com.example.smartcare.ui.SmartField
                                                                android:id="@+id/documentLeaveStart"
                                                                android:layout_width="match_parent"
                                                                android:layout_height="wrap_content"
                                                                android:layout_marginTop="8dp"
                                                                android:inputType="textNoSuggestions"
                                                                android:importantForAutofill="noExcludeDescendants"
                                                                android:maxLength="10"
                                                                app:sfHelper="@string/document_date_format"
                                                                app:sfLabel="@string/document_leave_start" />

                                                            <com.example.smartcare.ui.SmartField
                                                                android:id="@+id/documentDays"
                                                                android:layout_width="match_parent"
                                                                android:layout_height="wrap_content"
                                                                android:layout_marginTop="8dp"
                                                                android:inputType="number"
                                                                android:maxLength="10"
                                                                android:importantForAutofill="noExcludeDescendants"
                                                                app:sfLabel="@string/document_days" />

                                                            <TextView
                                                                android:id="@+id/documentCalculatedDates"
                                                                style="@style/SmartCare.Text.Sub"
                                                                android:layout_width="match_parent"
                                                                android:layout_height="wrap_content"
                                                                android:layout_marginTop="8dp"
                                                                android:text="@string/document_date_format"
                                                                android:visibility="gone" />
                                        </LinearLayout>

                                        <com.google.android.material.button.MaterialButton
                                            android:id="@+id/documentPreview"
                                            style="@style/SmartCare.Button.Pill"
                                            android:layout_width="match_parent"
                                            android:layout_marginTop="12dp"
                                            android:text="@string/document_preview" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/documentPreviewPanel"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">
                                        <TextView
                                            android:id="@+id/documentPreviewHeading"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:fontFamily="@font/figtree_bold"
                                            android:textColor="@color/ink"
                                            android:textSize="16sp"
                                            android:text="@string/document_preview_heading"
                                            android:accessibilityHeading="true" />

                                        <TextView
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            style="@style/SmartCare.Text.Sub"
                                            android:text="@string/document_preview_notice"
                                            android:layout_marginTop="4dp" />

                                        <com.google.android.material.button.MaterialButton
                                            android:id="@+id/documentEdit"
                                            style="@style/Widget.Material3.Button.OutlinedButton"
                                            android:layout_width="match_parent"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="12dp"
                                            android:text="@string/document_edit" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/documentDemoLabel"
                            style="@style/SmartCare.Text.Sub"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:text="@string/document_demo_label"
                            android:visibility="gone" />

                        <LinearLayout
                            android:id="@+id/documentResults"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">

                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/documentPdfActions"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:visibility="gone">
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/documentPdfPreview"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/document_pdf_preview" />
                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/documentPdfDownload"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="8dp"
                                android:text="@string/document_pdf_download" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/documentEmpty"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/SmartCare.Text.Sub"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/documentToggleEmpty"
                            style="@style/SmartCare.Text.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:minHeight="48dp"
                            android:gravity="center_vertical"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:focusable="true"
                            android:text="@string/medical_show_empty"
                            android:visibility="gone" />
            </LinearLayout>
    </LinearLayout>
</ScrollView>
