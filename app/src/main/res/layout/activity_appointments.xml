<?xml version="1.0" encoding="utf-8"?>
<!-- Staff: all patient bookings, with stats, a shortcut to Manage Slots and filters.
     AppointmentsActivity fills the stats, filter chips and cards. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="NestedWeights">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_auth_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="9dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_grab_handle" />

            <!-- Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    style="@style/SmartCare.Appt.Stat"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/statToday"
                        style="@style/SmartCare.Appt.StatValue"
                        tools:text="4" />

                    <TextView
                        style="@style/SmartCare.Appt.StatLabel"
                        android:text="@string/appt_stat_today" />
                </LinearLayout>

                <LinearLayout
                    style="@style/SmartCare.Appt.Stat"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:id="@+id/statUpcoming"
                        style="@style/SmartCare.Appt.StatValue"
                        tools:text="12" />

                    <TextView
                        style="@style/SmartCare.Appt.StatLabel"
                        android:text="@string/appt_stat_upcoming" />
                </LinearLayout>

                <LinearLayout style="@style/SmartCare.Appt.Stat">

                    <TextView
                        android:id="@+id/statTotal"
                        style="@style/SmartCare.Appt.StatValue"
                        tools:text="30" />

                    <TextView
                        style="@style/SmartCare.Appt.StatLabel"
                        android:text="@string/appt_stat_total" />
                </LinearLayout>
            </LinearLayout>

            <!-- Shortcut to Manage Slots -->
            <LinearLayout
                android:id="@+id/btnManageSlots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/appt_action_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/appt_icon_tile"
                    android:importantForAccessibility="no"
                    android:padding="11dp"
                    android:src="@drawable/ic_sc_calendar"
                    app:tint="?attr/scMain" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:text="@string/appt_manage_slots"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/SmartCare.Text.Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/appt_manage_slots_sub" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sc_arrow"
                    app:tint="@color/ink_sub" />
            </LinearLayout>

            <!-- Shortcut to book for a walk-in patient -->
            <LinearLayout
                android:id="@+id/btnBookForPatient"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-6dp"
                android:layout_marginBottom="18dp"
                android:background="@drawable/appt_action_card"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="14dp">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/appt_icon_tile"
                    android:importantForAccessibility="no"
                    android:padding="11dp"
                    android:src="@drawable/ic_sc_plus"
                    app:tint="?attr/scMain" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:text="@string/walkin_button"
                        android:textColor="@color/ink"
                        android:textSize="15sp" />

                    <TextView
                        style="@style/SmartCare.Text.Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/walkin_button_sub" />
                </LinearLayout>

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_sc_arrow"
                    app:tint="@color/ink_sub" />
            </LinearLayout>

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/filterRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:indeterminateTint="?attr/scMain"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/listContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
