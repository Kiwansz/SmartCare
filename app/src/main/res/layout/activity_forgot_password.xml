<?xml version="1.0" encoding="utf-8"?>
<!-- 4. Forgot password: email field, "Link sent" card after sending, resend.
     Shared by patients (Clinic Sky) and staff (Navy). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".ForgotPasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_auth_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="9dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="11dp"
                android:background="@drawable/bg_grab_handle" />

            <com.example.smartcare.ui.SmartField
                android:id="@+id/fieldEmail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="textEmailAddress"
                app:sfIcon="@drawable/ic_sc_mail"
                app:sfLabel="@string/field_email"
                app:sfPlaceholder="@string/hint_email_example" />

            <!-- Shown after the link is sent -->
            <LinearLayout
                android:id="@+id/cardSent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/bg_sent_card"
                android:orientation="horizontal"
                android:padding="14dp"
                android:visibility="gone"
                tools:visibility="visible">

                <ImageView
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_sent_icon"
                    android:importantForAccessibility="no"
                    android:padding="9dp"
                    android:src="@drawable/ic_sc_send"
                    app:tint="?attr/scMain" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:text="@string/link_sent_title"
                        android:textColor="@color/ink"
                        android:textSize="13.5sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:lineSpacingMultiplier="1.15"
                        android:text="@string/link_sent_desc"
                        android:textColor="@color/ink_sub"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSend"
                style="@style/SmartCare.Button.Pill"
                android:layout_width="match_parent"
                android:layout_marginTop="16dp"
                android:text="@string/action_send_link" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <TextView
                android:id="@+id/tvFooter"
                style="@style/SmartCare.Text.Sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/selectableItemBackground"
                android:gravity="center"
                android:padding="10dp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
