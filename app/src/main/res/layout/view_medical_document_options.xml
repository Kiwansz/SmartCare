<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:orientation="vertical"
    android:visibility="gone">
    <com.google.android.material.button.MaterialButton
        android:id="@+id/documentOpenPrescription"
        style="@style/SmartCare.Button.Pill"
        android:layout_width="match_parent"
        android:layout_marginTop="12dp"
        android:text="@string/document_prescription"
        app:icon="@drawable/ic_sc_file" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/documentOpenCertificate"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/document_certificate"
        app:icon="@drawable/ic_sc_calendar" />
</LinearLayout>
