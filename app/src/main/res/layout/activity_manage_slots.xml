<?xml version="1.0" encoding="utf-8"?>
<!-- Staff: create doctor slots and review saved ones. ManageSlotsActivity fills the
     picker values and the saved-slot cards. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:ignore="NestedWeights">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_auth_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="9dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_grab_handle" />

            <TextView
                style="@style/SmartCare.Appt.Section"
                android:text="@string/slot_new" />

            <!-- New slot form -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/clinic_card"
                android:orientation="vertical"
                android:padding="14dp">

                <include
                    android:id="@+id/tileDoctor"
                    layout="@layout/view_picker_tile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/tileDate"
                    layout="@layout/view_picker_tile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <include
                        android:id="@+id/tileStart"
                        layout="@layout/view_picker_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1" />

                    <include
                        android:id="@+id/tileEnd"
                        layout="@layout/view_picker_tile"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1" />
                </LinearLayout>

                <!-- Slot length: split the start-end window into several slots -->
                <TextView
                    style="@style/SmartCare.Appt.Section"
                    android:layout_marginTop="16dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/slot_len_label" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/lengthRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <!-- Repeat on more days -->
                <TextView
                    style="@style/SmartCare.Appt.Section"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="8dp"
                    android:text="@string/slot_repeat_label" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/repeatRow"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:id="@+id/weeksRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="@font/figtree_bold"
                        android:text="@string/slot_weeks_label"
                        android:textColor="@color/ink"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btnWeeksMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/appt_stepper_btn"
                        android:contentDescription="@string/slot_weeks_less"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_sc_minus"
                        app:tint="@color/ink" />

                    <TextView
                        android:id="@+id/tvWeeks"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        tools:text="2" />

                    <ImageButton
                        android:id="@+id/btnWeeksPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/appt_stepper_btn"
                        android:contentDescription="@string/slot_weeks_more"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_sc_plus"
                        app:tint="@color/ink" />
                </LinearLayout>

                <!-- Capacity stepper -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@font/figtree_bold"
                            android:text="@string/slot_capacity"
                            android:textColor="@color/ink"
                            android:textSize="14sp" />

                        <TextView
                            style="@style/SmartCare.Text.Sub"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="@string/slot_capacity_sub" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/btnCapacityMinus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/appt_stepper_btn"
                        android:contentDescription="@string/slot_capacity_less"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_sc_minus"
                        app:tint="@color/ink" />

                    <TextView
                        android:id="@+id/tvCapacity"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:textColor="@color/ink"
                        android:textSize="18sp"
                        tools:text="1" />

                    <ImageButton
                        android:id="@+id/btnCapacityPlus"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:background="@drawable/appt_stepper_btn"
                        android:contentDescription="@string/slot_capacity_more"
                        android:padding="9dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_sc_plus"
                        app:tint="@color/ink" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvBulkSummary"
                    style="@style/SmartCare.Text.Sub"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:visibility="gone"
                    tools:text="Creates 24 slots on 6 days."
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tvSlotStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:fontFamily="@font/figtree_semibold"
                    android:textSize="12.5sp"
                    android:visibility="gone"
                    tools:text="The end time must be after the start time."
                    tools:textColor="@color/danger"
                    tools:visibility="visible" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreateSlot"
                    style="@style/SmartCare.Button.Pill"
                    android:layout_width="match_parent"
                    android:layout_marginTop="14dp"
                    android:text="@string/slot_create"
                    app:icon="@drawable/ic_sc_plus"
                    app:iconGravity="textStart" />
            </LinearLayout>

            <TextView
                style="@style/SmartCare.Appt.Section"
                android:layout_marginTop="24dp"
                android:text="@string/slot_saved" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/filterRow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="16dp"
                android:indeterminateTint="?attr/scMain"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/listContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
