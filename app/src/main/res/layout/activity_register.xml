<?xml version="1.0" encoding="utf-8"?>
<!-- 3. Sign up in two steps. Step 1: name, IC (+ "From IC" cards), phone.
     Step 2: email, password + strength, confirm, terms. RegisterActivity shows one at a time. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_auth_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="9dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="11dp"
                android:background="@drawable/bg_grab_handle" />

            <!-- ===== Step 1 ===== -->
            <LinearLayout
                android:id="@+id/step1"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <com.example.smartcare.ui.SmartField
                    android:id="@+id/fieldFullName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    app:sfIcon="@drawable/ic_sc_user"
                    app:sfLabel="@string/field_full_name"
                    app:sfPlaceholder="@string/hint_full_name" />

                <com.example.smartcare.ui.SmartField
                    android:id="@+id/fieldIc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:digits="0123456789-"
                    android:inputType="phone"
                    android:maxLength="14"
                    app:sfHelper="@string/helper_ic"
                    app:sfIcon="@drawable/ic_sc_id"
                    app:sfLabel="@string/field_ic"
                    app:sfPlaceholder="@string/hint_ic_example" />

                <!-- Read-only "From IC" cards -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:layout_marginBottom="6dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:layout_weight="1.4"
                        android:background="@drawable/bg_ic_card"
                        android:orientation="vertical"
                        android:paddingStart="13dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="13dp"
                        android:paddingBottom="11dp">

                        <TextView
                            style="@style/SmartCare.Text.FromIc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/from_ic" />

                        <TextView
                            android:id="@+id/tvDob"
                            style="@style/SmartCare.Text.FromIcValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/from_ic_dob_placeholder" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:background="@drawable/bg_ic_card"
                        android:orientation="vertical"
                        android:paddingStart="13dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="13dp"
                        android:paddingBottom="11dp">

                        <TextView
                            style="@style/SmartCare.Text.FromIc"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/from_ic" />

                        <TextView
                            android:id="@+id/tvGender"
                            style="@style/SmartCare.Text.FromIcValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/from_ic_gender_placeholder" />
                    </LinearLayout>
                </LinearLayout>

                <com.example.smartcare.ui.SmartField
                    android:id="@+id/fieldPhone"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    android:inputType="phone"
                    app:sfIcon="@drawable/ic_sc_phone"
                    app:sfLabel="@string/field_phone"
                    app:sfPlaceholder="@string/hint_phone_example" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNext"
                    style="@style/SmartCare.Button.Pill"
                    android:layout_width="match_parent"
                    android:text="@string/action_next"
                    app:icon="@drawable/ic_sc_arrow" />
            </LinearLayout>

            <!-- ===== Step 2 ===== -->
            <LinearLayout
                android:id="@+id/step2"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="vertical"
                android:visibility="gone">

                <com.example.smartcare.ui.SmartField
                    android:id="@+id/fieldEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textEmailAddress"
                    app:sfIcon="@drawable/ic_sc_mail"
                    app:sfLabel="@string/field_email"
                    app:sfPlaceholder="@string/hint_email_example" />

                <com.example.smartcare.ui.SmartField
                    android:id="@+id/fieldPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    app:sfIcon="@drawable/ic_sc_lock"
                    app:sfLabel="@string/field_password"
                    app:sfPassword="true"
                    app:sfPlaceholder="@string/hint_password_new" />

                <include
                    android:id="@+id/meter"
                    layout="@layout/view_strength_meter" />

                <com.example.smartcare.ui.SmartField
                    android:id="@+id/fieldConfirm"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:imeOptions="actionDone"
                    app:sfIcon="@drawable/ic_sc_lock"
                    app:sfLabel="@string/field_confirm_password"
                    app:sfPassword="true"
                    app:sfPlaceholder="@string/hint_type_again" />

                <com.google.android.material.checkbox.MaterialCheckBox
                    android:id="@+id/cbTerms"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="-6dp"
                    android:layout_marginTop="4dp"
                    android:text="@string/terms_text"
                    android:textColor="@color/ink_sub"
                    android:textSize="12.5sp"
                    app:buttonTint="?attr/scMain" />

                <TextView
                    android:id="@+id/tvTermsError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:text="@string/error_terms"
                    android:textColor="@color/danger"
                    android:textSize="11.5sp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="24dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnCreate"
                    style="@style/SmartCare.Button.Pill"
                    android:layout_width="match_parent"
                    android:text="@string/action_create_account" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="12dp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
