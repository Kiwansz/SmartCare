<?xml version="1.0" encoding="utf-8"?>
<!-- Shared "Coming soon" screen (navy). Opened by any staff tile whose feature has no
     screen yet; it names the feature and, when known, the module owner. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ComingSoonActivity"
    tools:ignore="NestedWeights">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_auth_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="9dp"
            android:paddingEnd="20dp"
            android:paddingBottom="24dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_marginBottom="36dp"
                android:background="@drawable/bg_grab_handle" />

            <ImageView
                android:id="@+id/ivFeature"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:background="@drawable/bg_tile_icon"
                android:importantForAccessibility="no"
                android:padding="20dp"
                app:tint="?attr/scMain"
                tools:src="@drawable/ic_sc_calendar" />

            <TextView
                android:id="@+id/tvFeature"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp"
                android:fontFamily="@font/figtree_bold"
                android:gravity="center"
                android:textColor="@color/ink"
                android:textSize="20sp"
                tools:text="@string/feature_appointments" />

            <TextView
                android:id="@+id/tvBody"
                style="@style/SmartCare.Text.Sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:textSize="13.5sp"
                tools:text="@string/coming_soon_body" />

            <TextView
                android:id="@+id/tvOwner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_tile_icon"
                android:fontFamily="@font/figtree_semibold"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="8dp"
                android:textColor="?attr/scMain"
                android:textSize="12sp"
                tools:text="@string/coming_soon_other_module" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="32dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnBack"
                style="@style/SmartCare.Button.Pill"
                android:layout_width="match_parent"
                android:text="@string/action_back_home" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
