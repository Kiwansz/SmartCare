<?xml version="1.0" encoding="utf-8"?>
<!-- Staff home (Module 1 shell), navy theme. Real data only: the user's own account
     and the clinic_setting row. Clinic features open a shared "Coming soon" screen. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".StaffHomeActivity">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Header (id "header" so BaseActivity draws it behind the status bar) -->
            <LinearLayout
                android:id="@+id/header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?attr/scHeaderBackground"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="12dp"
                android:paddingEnd="20dp"
                android:paddingBottom="56dp">

                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="start|center_vertical"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        tools:ignore="UseCompoundDrawables">

                        <ImageView
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:background="@drawable/bg_brand_tile"
                            android:importantForAccessibility="no"
                            android:padding="5dp"
                            android:src="@drawable/ic_sc_pulse"
                            app:tint="?attr/scMain" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="@font/figtree_bold"
                            android:text="@string/app_name"
                            android:textColor="@color/white"
                            android:textSize="15.5sp" />
                    </LinearLayout>

                    <!-- Role badge: Staff or Doctor -->
                    <TextView
                        android:id="@+id/tvRoleBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:layout_gravity="end|center_vertical"
                        android:background="@drawable/bg_glass_pill"
                        android:drawablePadding="6dp"
                        android:fontFamily="@font/figtree_bold"
                        android:gravity="center"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:visibility="invisible"
                        app:drawableStartCompat="@drawable/ic_sc_staff_small"
                        app:drawableTint="@color/white"
                        tools:text="@string/role_badge_staff"
                        tools:visibility="visible" />
                </FrameLayout>

                <TextView
                    android:id="@+id/tvGreeting"
                    style="@style/SmartCare.Text.HeroSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    tools:text="@string/greeting_morning" />

                <TextView
                    android:id="@+id/tvName"
                    style="@style/SmartCare.Text.Hero"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="2"
                    tools:text="Siti Aminah" />

                <TextView
                    android:id="@+id/tvClinicName"
                    style="@style/SmartCare.Text.HeroSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:drawablePadding="6dp"
                    android:gravity="center_vertical"
                    android:visibility="gone"
                    app:drawableStartCompat="@drawable/ic_sc_home"
                    app:drawableTint="@color/hero_subtitle"
                    tools:text="SmartCare Clinic"
                    tools:visibility="visible" />
            </LinearLayout>

            <!-- White sheet -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="-28dp"
                android:layout_weight="1"
                android:background="@drawable/bg_sheet"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="9dp"
                android:paddingEnd="20dp"
                android:paddingBottom="24dp"
                tools:ignore="NestedWeights">

                <View
                    android:layout_width="36dp"
                    android:layout_height="4dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_grab_handle" />

                <!-- Loading -->
                <LinearLayout
                    android:id="@+id/stateLoading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="32dp"
                    android:paddingBottom="32dp">

                    <ProgressBar
                        android:layout_width="28dp"
                        android:layout_height="28dp" />

                    <TextView
                        style="@style/SmartCare.Text.Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/staff_home_loading" />
                </LinearLayout>

                <!-- Error (never raw Supabase text) -->
                <LinearLayout
                    android:id="@+id/stateError"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:paddingTop="24dp"
                    android:paddingBottom="24dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/tvError"
                        style="@style/SmartCare.Text.Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/staff_home_error" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRetry"
                        style="@style/SmartCare.Button.Pill"
                        android:layout_width="wrap_content"
                        android:layout_marginTop="16dp"
                        android:paddingStart="28dp"
                        android:paddingEnd="28dp"
                        android:text="@string/action_retry" />
                </LinearLayout>

                <!-- Content, shown once the account has loaded -->
                <LinearLayout
                    android:id="@+id/content"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <!-- Clinic rules: real values from clinic_setting, set by the Admin -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/figtree_bold"
                        android:text="@string/clinic_rules_title"
                        android:textColor="@color/ink"
                        android:textSize="16sp" />

                    <TextView
                        style="@style/SmartCare.Text.Sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/clinic_rules_sub" />

                    <LinearLayout
                        android:id="@+id/cardRules"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_tile"
                        android:divider="@drawable/bg_profile_divider"
                        android:orientation="vertical"
                        android:showDividers="middle">

                        <include android:id="@+id/rowGrace" layout="@layout/view_profile_row" />
                        <include android:id="@+id/rowCutoff" layout="@layout/view_profile_row" />
                        <include android:id="@+id/rowMaxActive" layout="@layout/view_profile_row" />
                        <include android:id="@+id/rowClinicPhone" layout="@layout/view_profile_row" />
                        <include android:id="@+id/rowClinicAddress" layout="@layout/view_profile_row" />
                    </LinearLayout>

                    <!-- Shown when the clinic_setting row is missing or cannot be read -->
                    <TextView
                        android:id="@+id/tvRulesEmpty"
                        style="@style/SmartCare.Text.Sub"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_tile"
                        android:gravity="center"
                        android:padding="18dp"
                        android:text="@string/clinic_rules_empty"
                        android:visibility="gone" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:minHeight="24dp" />

                <!-- Temporary: moves to the staff profile screen in a later step. -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogout"
                    style="@style/SmartCare.Button.Pill"
                    android:layout_width="match_parent"
                    android:text="@string/logout" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
