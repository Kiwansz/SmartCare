<?xml version="1.0" encoding="utf-8"?>
<!-- Tappable tile: icon, small label, value. Used for doctor / date / time on Manage Slots. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/appt_picker"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="58dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="9dp"
    android:paddingEnd="14dp"
    android:paddingBottom="9dp">

    <ImageView
        android:id="@+id/pickerIcon"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:importantForAccessibility="no"
        app:tint="?attr/scMain"
        tools:src="@drawable/ic_sc_calendar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/pickerLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/figtree_semibold"
            android:textColor="@color/ink_sub"
            android:textSize="11sp"
            tools:text="Date" />

        <TextView
            android:id="@+id/pickerValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:fontFamily="@font/figtree_bold"
            android:maxLines="1"
            android:textColor="@color/ink_placeholder"
            android:textSize="14.5sp"
            tools:text="Choose a date" />
    </LinearLayout>
</LinearLayout>
