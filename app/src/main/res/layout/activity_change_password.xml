<?xml version="1.0" encoding="utf-8"?>
<!-- 6. Change password (navy): forced on a staff member's first login.
     Rule chips tick off live; Save stays disabled until every rule passes. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ChangePasswordActivity"
    tools:ignore="NestedWeights">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_auth_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="9dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="11dp"
                android:background="@drawable/bg_grab_handle" />

            <com.example.smartcare.ui.SmartField
                android:id="@+id/fieldTemp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:sfIcon="@drawable/ic_sc_lock"
                app:sfLabel="@string/field_temp_password"
                app:sfPassword="true"
                app:sfPlaceholder="@string/hint_password_enter" />

            <com.example.smartcare.ui.SmartField
                android:id="@+id/fieldNew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                app:sfIcon="@drawable/ic_sc_lock"
                app:sfLabel="@string/field_new_password"
                app:sfPassword="true"
                app:sfPlaceholder="@string/hint_password_new" />

            <include
                android:id="@+id/meter"
                layout="@layout/view_strength_meter" />

            <!-- Rule chips (wrap onto a second line on narrow screens) -->
            <com.google.android.material.chip.ChipGroup
                android:id="@+id/chips"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp">

                <TextView android:id="@+id/chipLength" style="@style/SmartCare.RuleChip" android:text="@string/chip_length" />
                <TextView android:id="@+id/chipUpper" style="@style/SmartCare.RuleChip" android:text="@string/chip_upper" />
                <TextView android:id="@+id/chipNumber" style="@style/SmartCare.RuleChip" android:text="@string/chip_number" />
                <TextView android:id="@+id/chipMatch" style="@style/SmartCare.RuleChip" android:text="@string/chip_match" />
            </com.google.android.material.chip.ChipGroup>

            <com.example.smartcare.ui.SmartField
                android:id="@+id/fieldConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                app:sfIcon="@drawable/ic_sc_lock"
                app:sfLabel="@string/field_confirm_new_password"
                app:sfPassword="true"
                app:sfPlaceholder="@string/hint_type_again" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/SmartCare.Button.Pill"
                android:layout_width="match_parent"
                android:text="@string/action_save_continue" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
