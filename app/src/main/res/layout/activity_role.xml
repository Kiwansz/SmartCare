<?xml version="1.0" encoding="utf-8"?>
<!-- 1. Role picker: tall gradient header with emblem, white sheet with two choices + Continue. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    tools:context=".RoleActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header (same id as view_auth_header so BaseActivity applies the status bar inset) -->
        <LinearLayout
            android:id="@+id/header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/scHeaderBackground"
            android:clipChildren="false"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="76dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_brand_tile"
                    android:importantForAccessibility="no"
                    android:padding="5dp"
                    android:src="@drawable/ic_sc_pulse"
                    app:tint="?attr/scMain" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:fontFamily="@font/figtree_bold"
                    android:text="@string/app_name"
                    android:textColor="@color/white"
                    android:textSize="15.5sp" />
            </LinearLayout>

            <!-- Emblem: glass tile with two rings around it -->
            <FrameLayout
                android:layout_width="156dp"
                android:layout_height="156dp"
                android:layout_marginStart="-32dp"
                android:layout_marginTop="6dp"
                android:layout_marginBottom="-24dp">

                <View
                    android:layout_width="156dp"
                    android:layout_height="156dp"
                    android:background="@drawable/bg_ring_faint" />

                <View
                    android:layout_width="124dp"
                    android:layout_height="124dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_ring_strong" />

                <ImageView
                    android:layout_width="92dp"
                    android:layout_height="92dp"
                    android:layout_gravity="center"
                    android:background="@drawable/bg_emblem"
                    android:importantForAccessibility="no"
                    android:padding="24dp"
                    android:src="@drawable/ic_sc_pulse"
                    app:tint="@color/white" />
            </FrameLayout>

            <TextView
                style="@style/SmartCare.Text.Hero"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/role_hero_title" />

            <TextView
                style="@style/SmartCare.Text.HeroSub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:maxWidth="300dp"
                android:text="@string/role_hero_sub" />
        </LinearLayout>

        <!-- Sheet -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="9dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="15dp"
                android:background="@drawable/bg_grab_handle" />

            <include
                android:id="@+id/choicePatient"
                layout="@layout/view_choice_card" />

            <include
                android:id="@+id/choiceStaff"
                layout="@layout/view_choice_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="-4dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="-4dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnContinue"
                style="@style/SmartCare.Button.Pill"
                android:layout_width="match_parent"
                android:text="@string/action_continue"
                app:icon="@drawable/ic_sc_arrow" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
