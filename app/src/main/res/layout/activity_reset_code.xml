<?xml version="1.0" encoding="utf-8"?>
<!-- Forgot password, part 2: enter the emailed code and a new password.
     Clinic Sky for patients, navy for staff (theme set from the intent). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    tools:context=".ResetCodeActivity"
    tools:ignore="NestedWeights">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include layout="@layout/view_auth_header" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="-28dp"
            android:layout_weight="1"
            android:background="@drawable/bg_sheet"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="9dp"
            android:paddingEnd="20dp"
            android:paddingBottom="22dp">

            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="11dp"
                android:background="@drawable/bg_grab_handle" />

            <com.example.smartcare.ui.SmartField
                android:id="@+id/fieldCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:digits="0123456789"
                android:imeOptions="actionNext"
                android:inputType="number"
                android:maxLength="8"
                app:sfIcon="@drawable/ic_sc_mail"
                app:sfLabel="@string/field_reset_code"
                app:sfPlaceholder="@string/hint_reset_code" />

            <TextView
                android:id="@+id/linkResend"
                style="@style/SmartCare.Text.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginBottom="6dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="4dp"
                android:text="@string/resend_code" />

            <com.example.smartcare.ui.SmartField
                android:id="@+id/fieldNew"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:sfIcon="@drawable/ic_sc_lock"
                app:sfLabel="@string/field_new_password"
                app:sfPassword="true"
                app:sfPlaceholder="@string/hint_password_new" />

            <include
                android:id="@+id/meter"
                layout="@layout/view_strength_meter" />

            <com.google.android.material.chip.ChipGroup
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="10dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="6dp">

                <TextView android:id="@+id/chipLength" style="@style/SmartCare.RuleChip" android:text="@string/chip_length" />
                <TextView android:id="@+id/chipUpper" style="@style/SmartCare.RuleChip" android:text="@string/chip_upper" />
                <TextView android:id="@+id/chipNumber" style="@style/SmartCare.RuleChip" android:text="@string/chip_number" />
                <TextView android:id="@+id/chipMatch" style="@style/SmartCare.RuleChip" android:text="@string/chip_match" />
            </com.google.android.material.chip.ChipGroup>

            <com.example.smartcare.ui.SmartField
                android:id="@+id/fieldConfirm"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                app:sfIcon="@drawable/ic_sc_lock"
                app:sfLabel="@string/field_confirm_new_password"
                app:sfPassword="true"
                app:sfPlaceholder="@string/hint_type_again" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:minHeight="24dp" />

            <ProgressBar
                android:id="@+id/progress"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="12dp"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReset"
                style="@style/SmartCare.Button.Pill"
                android:layout_width="match_parent"
                android:text="@string/action_reset_password" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
