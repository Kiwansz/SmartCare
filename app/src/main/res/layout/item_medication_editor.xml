<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:background="@drawable/bg_tile"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:id="@+id/documentMedicationHeading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="@font/figtree_bold"
        android:textColor="@color/ink"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/documentQuickSelect"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/document_demo_picker" />

    <com.example.smartcare.ui.SmartField
        android:id="@+id/documentMedicineName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:inputType="textCapSentences"
        android:importantForAutofill="noExcludeDescendants"
        app:sfLabel="@string/document_medicine_name" />

    <com.example.smartcare.ui.SmartField
        android:id="@+id/documentDosage"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:inputType="textCapSentences"
        android:importantForAutofill="noExcludeDescendants"
        app:sfLabel="@string/document_dosage" />

    <com.example.smartcare.ui.SmartField
        android:id="@+id/documentFrequency"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:inputType="textCapSentences"
        android:importantForAutofill="noExcludeDescendants"
        app:sfLabel="@string/document_frequency" />

    <com.example.smartcare.ui.SmartField
        android:id="@+id/documentDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:inputType="textCapSentences"
        android:importantForAutofill="noExcludeDescendants"
        app:sfLabel="@string/document_duration" />

    <com.example.smartcare.ui.SmartField
        android:id="@+id/documentInstructions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:inputType="textCapSentences|textMultiLine"
        android:importantForAutofill="noExcludeDescendants"
        app:sfLabel="@string/document_instructions" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/documentRemoveMedication"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/document_remove_medication" />
</LinearLayout>
