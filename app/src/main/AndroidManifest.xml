<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SmartCare.Patient">
        <!-- 1. Role picker (first screen) -->
        <activity
            android:name=".RoleActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- 2. Patient login + 5. Staff login -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- 3. Patient sign up -->
        <activity
            android:name=".RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- 4. Forgot password -->
        <activity
            android:name=".ForgotPasswordActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- 4b. Forgot password: enter the emailed code (theme follows the caller) -->
        <activity
            android:name=".ResetCodeActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- 5. Staff login (navy) -->
        <activity
            android:name=".StaffLoginActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartCare.Staff"
            android:windowSoftInputMode="adjustResize" />
        <!-- 6. Change password (navy, staff first login) -->
        <activity
            android:name=".ChangePasswordActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartCare.Staff"
            android:windowSoftInputMode="adjustResize" />
        <!-- 7. Patient home -->
        <activity
            android:name=".HomeActivity"
            android:exported="false" />
        <!-- Patient profile -->
        <activity
            android:name=".ProfileActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />
        <!-- 8. Staff home placeholder (navy) -->
        <activity
            android:name=".StaffHomeActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartCare.Staff" />
        <activity
            android:name=".StaffProfileActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartCare.Staff" />
        <activity
            android:name=".ComingSoonActivity"
            android:exported="false"
            android:theme="@style/Theme.SmartCare.Staff" />
    </application>

</manifest>